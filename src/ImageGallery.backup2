// src/ImageGallery.jsx
import React, { useState } from 'react';

import start from './img/start.png';
import start_sel from './img/start_sel.png';
import main from './img/main.png';
import main_highlight from './img/main_highlight.png';
import main_sel from './img/main_sel.png';
import info from './img/info.png';
import info_highlight from './img/info_highlight.png';
import info_sel from './img/info_sel.png';
import fav from './img/fav.png';
import fav_highlight from './img/fav_highlight.png';
import fav_sel from './img/fav_sel.png';
import socials from './img/socials.png';
import socials_highlight from './img/socials_highlight.png';
import socials_sel from './img/socials_sel.png';
import taskbar from './img/taskbar.png';
import time from './img/time.png';

export default function ImageGallery() {
  const [isHovered, setIsHovered] = useState(false);
  const [isHovered2, setIsHovered2] = useState(false);
  const [isHovered3, setIsHovered3] = useState(false);
  const [isHovered4, setIsHovered4] = useState(false);
  const [isHovered5, setIsHovered5] = useState(false);

  const [activePage, setActivePage] = useState("main");

  // Flat base style for the button images
  const imageStyle = {
    height: '30px',
    margin: 0,
    padding: 0,
    border: 'none',
    display: 'inline-block',
    verticalAlign: 'top',
    cursor: 'pointer',
    objectFit: 'fill' // 🟢 Forces buttons to match container constraints
  };

  return (
    <>
      {/* 📥 1. THE STRETCHED BACKGROUND BAR (Matching your exact CSS class properties!) */}
      <img 
        src={taskbar} 
        alt="" 
        style={{
          position: 'fixed',
          top: 0,
          left: 0,
          zIndex: 1,
          pointerEvents: 'none',
          margin: 0,
          padding: 0,
          display: 'block',
          
          // 🌟 YOUR EXACT WORKING CSS APPLIED HERE:
          width: '100vw',
          height: '30px',
          objectFit: 'fill', 
        }} 
      />

      {/* 📥 2. THE BUTTONS ROW: Placed directly over the bar using absolute position flow */}
      <div style={{
        position: 'fixed',
        top: 0,
        left: 0,
        width: '100vw',
        height: '30px',
        zIndex: 9999,
        whiteSpace: 'nowrap',
        overflowX: 'auto',
        margin: 0,
        padding: 0,
        display: 'flex',
        alignItems: 'flex-start',
        
        // Hides mobile scrollbar tracks cleanly
        scrollbarWidth: 'none',
        msOverflowStyle: 'none',
      }}>
        
        {/* START BUTTON */}
        <img 
          src={isHovered ? start_sel : start} 
          alt="Start"
          style={{ ...imageStyle, width: '106px' }}
          onMouseEnter={() => setIsHovered(true)}
          onMouseLeave={() => setIsHovered(false)}
          onClick={() => alert("Start menu clicked!")}
        />

        {/* MAIN PAGE */}
        <img 
          src={activePage === "main" ? main_sel : (isHovered2 ? main_highlight : main)} 
          alt="Main"
          style={{ ...imageStyle, width: '160px', cursor: activePage === "main" ? "default" : "pointer" }}
          onMouseEnter={() => setIsHovered2(true)}
          onMouseLeave={() => setIsHovered2(false)}
          onClick={() => setActivePage("main")}
        />

        {/* INFO */}
        <img 
          src={activePage === "info" ? info_sel : (isHovered3 ? info_highlight : info)} 
          alt="Info"
          style={{ ...imageStyle, width: '160px', cursor: activePage === "info" ? "default" : "pointer" }}
          onMouseEnter={() => setIsHovered3(true)}
          onMouseLeave={() => setIsHovered3(false)}
          onClick={() => setActivePage("info")}
        />

        {/* MUSIC */}
        <img 
          src={activePage === "music" ? fav_sel : (isHovered4 ? fav_highlight : fav)} 
          alt="Music"
          style={{ ...imageStyle, width: '160px', cursor: activePage === "music" ? "default" : "pointer" }}
          onMouseEnter={() => setIsHovered4(true)}
          onMouseLeave={() => setIsHovered4(false)}
          onClick={() => setActivePage("music")}
        />

        {/* SOCIALS */}
        <img 
          src={activePage === "socials" ? socials_sel : (isHovered5 ? socials_highlight : socials)} 
          alt="Socials"
          style={{ ...imageStyle, width: '160px', cursor: activePage === "socials" ? "default" : "pointer" }}
          onMouseEnter={() => setIsHovered5(true)}
          onMouseLeave={() => setIsHovered5(false)}
          onClick={() => setActivePage("socials")}
        />

        {/* TIME BOX */}
        <img 
          src={time} 
          alt="Time"
          style={{ ...imageStyle, width: '129px', cursor: 'default' }}
        />

      </div>

      {/* CENTER PAGE CONTENT OUTPUT WINDOWS */}
      <div style={{ position: 'fixed', top: '60px', left: '20px', right: '20px', zIndex: 5000, color: "white", fontFamily: "monospace" }}>
        {activePage === "main" && <div><h1>Welcome to the Main Page</h1></div>}
        {activePage === "info" && <div><h1>About Me / Info</h1></div>}
        {activePage === "music" && <div><h1>My Favorite Tracks</h1></div>}
        {activePage === "socials" && <div><h1>Connect with Me</h1></div>}
      </div>
    </>
  );
}